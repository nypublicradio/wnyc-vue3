{
  // https://nuxt.com/docs/guide/concepts/typescript
  // .nuxt/tsconfig.json covers app + server + shared (DOM lib, auto-imports, #aliases).
  // Don't override "paths" or "moduleResolution" here: "paths" replaces Nuxt's
  // generated aliases (~, @, #imports, #app...) instead of merging with them.
  "extends": "./.nuxt/tsconfig.json",
  "files": ["types.d.ts"],
  "compilerOptions": {
    "strict": false,
    "allowJs": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  }
}