{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "claude-team-kit": {
      "source": {
        "source": "github",
        "repo": "skacula/claude-team-kit"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail",
        "ref": "v5.3.1"
      }
    },
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude",
        "ref": "v0.9.86"
      }
    }
  },
  "enabledPlugins": {
    "flow@claude-team-kit": true,
    "ponytail@ponytail": true,
    "pstack@pstack-claude": true,
    "code-metrics-complexity-and-duplication-report@anthropic-plugin-directory": true
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh search:*)",
      "Bash(gh label list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(acli jira auth status:*)",
      "Bash(acli jira project view:*)",
      "Bash(acli jira workitem view:*)",
      "Bash(acli jira workitem search:*)",
      "Bash(acli jira workitem comment list:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)"
    ]
  }
}
